{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit && tsc --project tsconfig.seed.json",
    "test": "node tests/run-database-tests.mjs tests/auth.integration.test.ts tests/day2.integration.test.ts tests/day3.integration.test.ts tests/dashboard.integration.test.ts",
    "test:auth": "node tests/run-database-tests.mjs tests/auth.integration.test.ts",
    "test:day2": "node tests/run-database-tests.mjs tests/day2.integration.test.ts",
    "test:day3": "node tests/run-database-tests.mjs tests/day3.integration.test.ts",
    "test:dashboard": "node tests/run-database-tests.mjs tests/dashboard.integration.test.ts",
    "test:auth:database": "tsx --test --test-concurrency=1 tests/auth.integration.test.ts",
    "test:day2:database": "tsx --test --test-concurrency=1 tests/day2.integration.test.ts",
    "test:day3:database": "tsx --test --test-concurrency=1 tests/day3.integration.test.ts",
    "test:dashboard:database": "tsx --test --test-concurrency=1 tests/dashboard.integration.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@electric-sql/pglite-socket": "^0.1.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
